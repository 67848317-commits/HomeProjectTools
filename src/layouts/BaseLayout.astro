---
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { SITE_CONFIG } from '../data/siteConfig.ts';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  currentPath?: string;
  jsonLdGraph?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalUrl,
  ogType = 'website',
  noindex = false,
  currentPath = '/',
  jsonLdGraph = [],
} = Astro.props;

const ga4Id =
  (import.meta.env.PUBLIC_GA4_MEASUREMENT_ID as string | undefined) ||
  (typeof process !== 'undefined' ? process.env.PUBLIC_GA4_MEASUREMENT_ID || process.env.VITE_PUBLIC_GA4_MEASUREMENT_ID : '') ||
  '';
const cleanGa4Id = ga4Id.trim();

const jsonLdPayload =
  !noindex && jsonLdGraph.length > 0
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': jsonLdGraph,
      })
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5f0" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_CONFIG.siteName} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="google-adsense-account" content="ca-pub-1850854173653124" />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1850854173653124"
      crossorigin="anonymous"
    ></script>
    {cleanGa4Id && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${cleanGa4Id}`}
        ></script>
        <script is:inline define:vars={{ ga4Id: cleanGa4Id }}>
          window.PUBLIC_GA4_MEASUREMENT_ID = ga4Id;
          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function () {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());
          window.gtag('config', ga4Id);
          window.__GA4_HEAD_INITIALIZED__ = true;
        </script>
      </>
    )}
    {jsonLdPayload && (
      <script id="schema-jsonld" type="application/ld+json" set:html={jsonLdPayload} />
    )}
  </head>
  <body>
    <div class="min-h-screen flex flex-col bg-[#f7f5f0] text-[#1c1917] antialiased">
      <Header currentPath={currentPath} />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
