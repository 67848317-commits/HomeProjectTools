---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import { SITE_CONFIG, getCanonicalUrl } from '../data/siteConfig.ts';
import { Ruler, Home, Layers, Calculator, ArrowRight } from 'lucide-react';

const title = `Page Not Found | ${SITE_CONFIG.siteName}`;
const description =
  'The requested page could not be found. Return to Home Project Planner to plan your residential project and estimate materials.';
const canonicalUrl = getCanonicalUrl('/404');
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  noindex={true}
  currentPath="/404"
>
  <div class="py-16 md:py-24">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-[#f1ede4] border border-[#e3ded4] text-xs font-mono text-[#78716c] uppercase tracking-wider mb-6">
          <Ruler className="h-3.5 w-3.5 text-[#b8532b]" />
          Error 404 • Missing Measurement
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-[#1c1917] tracking-tight mb-4">
          Page Not Found
        </h1>

        <p class="text-base sm:text-lg text-[#57534e] leading-relaxed mb-8">
          The page or worksheet you requested does not exist, was removed, or may have had its address updated.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-12">
          <a
            href="/"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded bg-[#b8532b] text-white font-medium text-sm hover:bg-[#9c4320] transition-colors shadow-xs"
          >
            <Home className="h-4 w-4" />
            Return to Homepage
          </a>
          <a
            href="/projects"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded bg-[#ffffff] border border-[#e3ded4] text-[#1c1917] font-medium text-sm hover:border-[#b8532b] transition-colors shadow-xs"
          >
            <Layers className="h-4 w-4 text-[#78716c]" />
            Browse All Projects
          </a>
        </div>

        <div class="bg-[#ffffff] border border-[#e3ded4] rounded-lg p-6 text-left">
          <h2 class="font-serif text-base font-bold text-[#1c1917] mb-3 flex items-center gap-2">
            <Calculator className="h-4 w-4 text-[#b8532b]" />
            Popular Estimating Worksheets
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
            <a
              href="/calculators/flooring-calculator"
              class="flex items-center justify-between p-2.5 rounded bg-[#f7f5f0] border border-[#e3ded4] text-[#1c1917] hover:border-[#b8532b] transition-colors"
            >
              <span>Flooring &amp; Cartons</span>
              <ArrowRight className="h-3 w-3 text-[#78716c]" />
            </a>
            <a
              href="/calculators/concrete-slab-calculator"
              class="flex items-center justify-between p-2.5 rounded bg-[#f7f5f0] border border-[#e3ded4] text-[#1c1917] hover:border-[#b8532b] transition-colors"
            >
              <span>Concrete Slab &amp; Bags</span>
              <ArrowRight className="h-3 w-3 text-[#78716c]" />
            </a>
            <a
              href="/calculators/paint-calculator"
              class="flex items-center justify-between p-2.5 rounded bg-[#f7f5f0] border border-[#e3ded4] text-[#1c1917] hover:border-[#b8532b] transition-colors"
            >
              <span>Interior Paint Gallons</span>
              <ArrowRight className="h-3 w-3 text-[#78716c]" />
            </a>
            <a
              href="/calculators/mulch-calculator"
              class="flex items-center justify-between p-2.5 rounded bg-[#f7f5f0] border border-[#e3ded4] text-[#1c1917] hover:border-[#b8532b] transition-colors"
            >
              <span>Garden Mulch &amp; Yards</span>
              <ArrowRight className="h-3 w-3 text-[#78716c]" />
            </a>
          </div>
        </div>
      </div>
    </Container>
  </div>
</BaseLayout>
