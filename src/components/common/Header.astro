---
import Container from './Container.astro';
import { Ruler, Menu, X, ArrowRight } from 'lucide-react';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isHome = currentPath === '/';
---

<header class="border-b border-[#e3ded4] bg-[#ffffff] sticky top-0 z-40 shadow-[0_1px_3px_rgba(0,0,0,0.03)]">
  <Container>
    <div class="flex h-16 items-center justify-between">
      <!-- Zone 1: Wordmark / Brand -->
      <div class="flex items-center gap-3">
        <a
          href="/"
          class="group flex items-center gap-2.5 text-[#1c1917] focus:outline-none focus:ring-2 focus:ring-[#b8532b] focus:ring-offset-2 rounded"
          aria-label="Home Project Tools Homepage"
        >
          <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-[#c8c1b2] bg-[#f7f5f0] text-[#b8532b] group-hover:border-[#b8532b] transition-colors shadow-2xs">
            <Ruler className="h-4.5 w-4.5" />
          </div>
          <span class="font-serif font-bold text-lg leading-tight tracking-tight text-[#1c1917] group-hover:text-[#b8532b] transition-colors whitespace-nowrap">
            Home Project Tools
          </span>
        </a>
      </div>

      <!-- Zone 2: Navigation Links -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-[#57534e]" aria-label="Main Navigation">
        <a
          href="/projects"
          class={`hover:text-[#1c1917] transition-colors ${
            currentPath.startsWith('/projects') ? 'text-[#b8532b] font-semibold' : ''
          }`}
        >
          Projects & Tools
        </a>
        <a
          href="/#popular-calculators"
          class="hover:text-[#1c1917] transition-colors"
        >
          Calculators
        </a>
        <a
          href="/#project-plans"
          class="hover:text-[#1c1917] transition-colors"
        >
          Project Plans
        </a>
        <a
          href="/#planning-guides"
          class={`hover:text-[#1c1917] transition-colors ${
            currentPath.startsWith('/guides') ? 'text-[#b8532b] font-semibold' : ''
          }`}
        >
          Guides
        </a>
        <a
          href="/methodology"
          class={`hover:text-[#1c1917] transition-colors ${
            currentPath === '/methodology' ? 'text-[#b8532b] font-semibold' : ''
          }`}
        >
          Methodology
        </a>
        <a
          href="/about"
          class={`hover:text-[#1c1917] transition-colors ${
            currentPath === '/about' ? 'text-[#b8532b] font-semibold' : ''
          }`}
        >
          About
        </a>
      </nav>

      <!-- Zone 3: Primary Action CTA & Mobile Toggle -->
      <div class="flex items-center gap-3">
        <a
          href={isHome ? '#project-categories' : '/projects'}
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded bg-[#b8532b] text-[#ffffff] font-semibold text-xs hover:bg-[#9e431f] transition-colors shadow-2xs whitespace-nowrap"
        >
          <span>Start a Project</span>
          <ArrowRight className="h-3.5 w-3.5" />
        </a>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="md:hidden p-2 rounded text-[#57534e] hover:text-[#1c1917] hover:bg-[#f7f5f0] border border-[#e3ded4]"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
        >
          <span id="mobile-icon-open"><Menu className="h-5 w-5" /></span>
          <span id="mobile-icon-close" class="hidden"><X className="h-5 w-5" /></span>
        </button>
      </div>
    </div>

    <!-- Mobile menu dropdown -->
    <div id="mobile-nav-menu" class="hidden md:hidden border-t border-[#e3ded4] py-4 px-2 space-y-2 bg-[#ffffff]">
      <a
        href="/projects"
        class="block px-3 py-2 text-sm font-medium rounded text-[#57534e] hover:bg-[#f7f5f0] hover:text-[#1c1917]"
      >
        Projects & Tools
      </a>
      <a
        href="/#popular-calculators"
        class="block px-3 py-2 text-sm font-medium rounded text-[#57534e] hover:bg-[#f7f5f0] hover:text-[#1c1917]"
      >
        Popular Calculators
      </a>
      <a
        href="/#project-plans"
        class="block px-3 py-2 text-sm font-medium rounded text-[#57534e] hover:bg-[#f7f5f0] hover:text-[#1c1917]"
      >
        Complete Project Plans
      </a>
      <a
        href="/#planning-guides"
        class="block px-3 py-2 text-sm font-medium rounded text-[#57534e] hover:bg-[#f7f5f0] hover:text-[#1c1917]"
      >
        Planning Guides
      </a>
      <a
        href="/methodology"
        class="block px-3 py-2 text-sm font-medium rounded text-[#57534e] hover:bg-[#f7f5f0] hover:text-[#1c1917]"
      >
        Methodology
      </a>
      <a
        href="/about"
        class="block px-3 py-2 text-sm font-medium rounded text-[#57534e] hover:bg-[#f7f5f0] hover:text-[#1c1917]"
      >
        About
      </a>
      <div class="pt-2 border-t border-[#f1ede4]">
        <a
          href="/projects"
          class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded bg-[#b8532b] text-[#ffffff] font-semibold text-xs hover:bg-[#9e431f]"
        >
          <span>Start a Project</span>
          <ArrowRight className="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
  </Container>
</header>

<script is:inline>
  (() => {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-nav-menu');
    const iconOpen = document.getElementById('mobile-icon-open');
    const iconClose = document.getElementById('mobile-icon-close');
    if (!toggleBtn || !menu) return;

    toggleBtn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      toggleBtn.setAttribute('aria-expanded', String(!isHidden));
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', !isHidden);
        iconClose.classList.toggle('hidden', isHidden);
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        if (iconOpen && iconClose) {
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
      });
    });
  })();
</script>
