{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "astro dev --port 3000 --host 0.0.0.0",
    "build": "node --import tsx scripts/generate-sitemap.ts && astro build",
    "preview": "astro preview --port 3000 --host 0.0.0.0",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test 'tests/*.test.ts' 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@astrojs/react": "5.0.7",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "6.4.8",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^7.3.8"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
