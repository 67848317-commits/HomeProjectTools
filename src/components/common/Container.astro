---
interface Props {
  className?: string;
  size?: 'default' | 'narrow' | 'wide';
}

const { className = '', size = 'default' } = Astro.props;

const sizeClasses = {
  narrow: 'max-w-4xl',
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
};
---

<div class={`mx-auto w-full px-4 sm:px-6 lg:px-8 ${sizeClasses[size]} ${className}`}>
  <slot />
</div>
